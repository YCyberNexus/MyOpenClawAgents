# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IntelliJ / JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Editor backups / swap
*~
*.swp
*.swo
# drawio autosave backups (e.g. .$statemachine.v2.drawio.bkp)
.$*.bkp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# Logs
*.log

# Offline release packages
openclaw-rhel7-offline-*.zip

# Claude Code hook sentinels (state, not config)
workspace-acpx_auto_tester/.claude/.review-done-sha
workspace-acpx_auto_tester/.claude/.review-baseline
workspace-req_dispatcher/.claude/.review-done-sha
workspace-req_dispatcher/.claude/.review-baseline
workspace-req_executor/.claude/.review-done-sha
workspace-req_executor/.claude/.review-baseline

# Required OpenClaw recovery triggers are deployment configuration. Keep these
# two fixed heartbeat files versioned even when a workstation excludes generic
# workspace runtime files in .git/info/exclude.
!workspace-req_dispatcher/HEARTBEAT.md
!workspace-req_executor/HEARTBEAT.md

# OpenClaw local workspace runtime state (generated on first local agent run)
workspace-*/.openclaw/
workspace-*/memory/

# Local GitLab runner secrets
workspace-git_issuer/config/gitlab.env
workspace-req_dispatcher/config/dispatcher.local.env
workspace-req_executor/config/campaign_defaults.local.env
