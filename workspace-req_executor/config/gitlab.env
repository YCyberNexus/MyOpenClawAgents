# GitLab Deployment Pin
#
# These values are committed to the repo and synced to every runner. They
# replace the per-tick host parsing the agent used to do from
# ${GITLAB_ADDRESS}, which was fragile under long-running scheduled execution.
#
# Edit ONLY when you genuinely change which GitLab server this workspace
# talks to. Trigger inputs do not override this file.
#
# This file is `source`d by scripts/glab_auth.sh, so keep it pure
# `KEY=value` lines — no shell logic.

# Hostname (and port if non-default) of the pinned GitLab instance.
# scripts/glab_auth.sh exports this as an env var; glab reads it natively.
# Do NOT pass --hostname to glab api/mr/issue calls — only the auth
# bootstrap inside glab_auth.sh uses --hostname (see SOUL.md §GitLab Access).
GITLAB_HOST=gitlab-b.pxsemic.tech:30000

# API protocol — must be exactly "http" or "https".
GITLAB_API_PROTOCOL=http

# Optional runner-side token fallback. Keep the committed value empty. Prefer
# process env or a runner-local deployment copy for real secrets.
GITLAB_TOKEN=

# Wiki GitLab read/auth pins. These are sourced by glab_auth.sh and any
# wiki-facing helpers that need a separate read-only GitLab credential.
WIKI_GITLAB_HOST=gitlab-b.pxsemic.tech:30000
WIKI_GITLAB_API_PROTOCOL=http
WIKI_GITLAB_TOKEN=d8FCjmBv6yDQ5N3THcQ5
WIKI_GLAB_BIN=glab
