# Campaign Defaults Pin — clone parent and agent scheduler
#
# This file is `source`d (and may be loaded under `set -a`), so keep it pure
# `KEY=value` lines — NO shell logic, NO command substitution, NO conditionals.

# Absolute parent directory under which the project is cloned. The final clone
# target is ${REPO_PARENT_PATH}/${PROJECT}.
REPO_PARENT_PATH=/data

# Agent-wide driven-batch scheduler state lives outside project clones so every
# project shares one physical concurrency limit and one round-robin cursor.
EXECUTOR_SCHEDULER_ROOT=/data/req_executor/_scheduler
EXECUTOR_MAX_CONCURRENCY=3
EXECUTOR_RUNNING_LEASE_SECONDS=21600

# For the first day after the lock-layout upgrade, current wrappers acquire
# both the former hot-directory lock and the new independent lock. Set to 0
# only after every pre-upgrade executor process has stopped.
DRIVEN_LEGACY_LOCK_COMPAT_SECONDS=86400

# Authenticated OpenClaw route pins. I1 must name this executor and must return
# every I3 to this exact dispatcher task; trigger data cannot redirect either.
EXECUTOR_AGENT=req_executor
DISPATCHER_CALLBACK_TARGET=agent:req_dispatcher:main
