# Optional target-repo ignore snippet
#
# req_executor normally writes this rule to .git/info/exclude in each local
# clone, so target repositories do not need to commit it. Keep this snippet only
# for operators who want the same local ignore behavior in a manual checkout.

.req_executor/

# Generic project logs are ignored by the req_executor clone as well.
# stage_and_guard.sh still force-adds its singular staging-time LOG_DIR under
# .req_executor/, and archive_execution_logs.sh publishes the terminal LOG_DIR
# on its append-only req-executor-logs branch. Unrelated logs/ paths stay out.
logs/
