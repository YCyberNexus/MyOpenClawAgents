# req_dispatcher 部署期配置（deployment-time pin）。
# 在每台部署本 agent 的 runner 上编辑一次；agent 运行时不改写本文件。
#
# 重要：group / project / 具体目标仓 —— 不在此处。
# 这是全公司共用链路，目标 project 随需求文本传入；req_dispatcher 只从文本中提取明确的
# group/project 用于生成下游消息，issue 事实仍以 git_issuer 返回 JSON 为准。

# 下游目标 agent 名（req_dispatcher 跨 agent 派发给它建 issue + 打执行器入口标签）。
GIT_ISSUER_AGENT=git_issuer

# 运行时 state 根目录：pending.json / executor_queue.json / ledger.jsonl / 锁 / 序号 / 日志 都在 ${STATE_ROOT}/_dispatcher/ 下。
# 必须是 server 上 agent 可写的持久目录。
STATE_ROOT=/data/req_dispatcher

# executor timeout 预算的单一真实来源。执行/恢复路径显式 source
# source_executor_timeout_budget.sh，严格读取 scheduler_state.json 中持久化的
# acpx_timeout_seconds，再派生下面所有外层值。普通建单、控制命令和回调不读取该 state。
EXECUTOR_SCHEDULER_STATE_FILE=/data/req_executor/_scheduler/scheduler_state.json
EXECUTOR_ACPX_TIMEOUT_SECONDS=3600
# 独立的 OpenClaw 全局安全上限；/timeout-executor 不修改它。
OPENCLAW_SUBAGENT_TIMEOUT_SECONDS=20400

# 默认一小时 acpx 对应的 stuck 预算；执行/恢复时派生为 ceil((acpx+4200)/60)+20，
# 并在创建旧 FIFO active/pending 时固化，后续调低配置不追溯缩短在途记录。
STUCK_AFTER_MINUTES=150

# 可选：失败通知 channel（launch_failed / git_issuer 失败 / stuck 驱逐时通知运维）。留空则不通知。
# 形态 = 企业微信群机器人 webhook URL（http/https）。消费方：scripts/ops_notify.sh
# （best-effort：发送失败不阻断失败路径，仅形态写错才报错）。要换其它通知形态就改该脚本。
OPS_NOTIFY_CHANNEL=

# 可选：若将来需要 req_dispatcher 向 git_issuer 显式指定执行器入口标签（默认空＝由 git_issuer 自决打哪个标签）。
DEFAULT_ENTRY_LABEL=

# 默认执行器 agent：所有形态合法的 GitLab project（group/project）默认都路由到这里。
# ROUTING_FILE 只作为少数 project 需要专属 executor 时的覆盖表。
DEFAULT_EXECUTOR_AGENT=req_executor

# 下游 agent 单次 turn 调用超时（秒）：run_agent_turn.sh 传给 `openclaw agent --timeout`。
DOWNSTREAM_AGENT_TIMEOUT_SECONDS=600
# req_executor 单次 turn 调用超时（秒）：运行时派生为 acpx+3600。
# git_issuer 仍使用上面的通用下游超时；执行器业务内部 acpx 超时由 req_executor 自己配置。
EXECUTOR_AGENT_TIMEOUT_SECONDS=7200

# req_dispatcher 调用 submit_executor_batch.sh 时使用的 OpenClaw exec 工具 timeout：acpx+3900。
EXECUTOR_EXEC_TOOL_TIMEOUT_SECONDS=7500

# executor durable FIFO queue 恢复与启动重试参数。
# active 卡在 launching 超过该秒数后，下一次 RUN_EXECUTOR_QUEUE_DRAIN 可复用同一 run_id/correlation_id 重新启动。
# 默认值为 acpx+4200，晚于 executor turn 和 exec 工具超时，避免正常长任务被重复启动。
EXECUTOR_QUEUE_LAUNCH_RECLAIM_SECONDS=7800
# active 标为 launch_failed 后，下一次 drain 允许重试前等待的秒数。
EXECUTOR_QUEUE_LAUNCH_RETRY_BACKOFF_SECONDS=60
# 单次 drain 对同一 RUN_SINGLE_ISSUE payload 的启动尝试次数和固定退避。
EXECUTOR_QUEUE_SPAWN_MAX_ATTEMPTS=3
EXECUTOR_QUEUE_SPAWN_RETRY_SLEEP_SECONDS=2

# 可选 project 覆盖路由表：git_issuer 返回 project 后，先按本表查专属 executor；
# 未命中则回落到 DEFAULT_EXECUTOR_AGENT。行格式 `PROJECT=AGENT`，详见 config/README.md。
# 默认相对 SKILL_DIR（调用约定 `cd "<SKILL_DIR>" && source scripts/source_dispatcher_env.sh`），
# 也可改成 server 上的绝对路径。文件缺失/格式错 → route_project.sh exit 2（部署期配置写错）。
ROUTING_FILE=../../config/routing.env

# 可选：GitLab wiki 只读拉取配置。仅用于 prepare_wiki_downstream_payloads.sh
# 在接入消息包含 GitLab wiki URL 时读取需求文档；不得用于建 issue、打标签或写 note。
# 当前部署要求明文写在本文件中；dispatcher.local.env 仍可在本机覆盖。
WIKI_GITLAB_HOST=gitlab-b.pxsemic.tech:30000
WIKI_GITLAB_API_PROTOCOL=http
WIKI_GITLAB_TOKEN=d8FCjmBv6yDQ5N3THcQ5
WIKI_GLAB_BIN=glab

# 用户结果推送通道：req_dispatcher 主动给企微发起人（origin）推实质结果（受理 ack 之外）。
# 机制已对齐：104 反向调用 114 OpenClaw 网关，把结果信封投给 114 上的接收 agent；
# 该回推使用独立协议 4 适配器，104 主 OpenClaw 仍保持 2026.4.9、本机通信仍走协议 3；
# 适配器只读 104 的持久设备身份，首次连接需在 114 批准 operator.write 配对请求。
# 接收 agent 负责按 origin 完成企微最后一跳。只有 ORIGIN_JSON 是合法 object 时才出站；
# 目标 agent 优先取 origin.reply_agent，该字段为空时才使用 DEFAULT_REPLY_AGENT 兜底。
# ORIGIN_JSON 为空/null/非 object 时视为手动入口，不推 114。缺少网关 pin 或最终目标
# agent 时 scripts/notify_user.sh no-op（仅记 ledger 留痕、不静默丢）。
REPLY_GATEWAY_URL=
REPLY_GATEWAY_TOKEN=
# 默认接收结果的 114 agent 名；合法 origin object 缺 reply_agent 时使用。
DEFAULT_REPLY_AGENT=
REPLY_NOTIFY_TIMEOUT_SECONDS=30
# Gateway 握手、agent 终态响应与进程收尾的额外 watchdog 宽限；总预算为上值加本值。
# 必须不小于 31，以覆盖协议适配器内部 30 秒的终态等待宽限。
REPLY_NOTIFY_WATCHDOG_GRACE_SECONDS=35

# 必填结果回调目标：batch I1 与旧 RUN_SINGLE_ISSUE bridge 都把本值作为
# dispatcher_callback_target 传给 req_executor；执行器 Phase 6 终态据此把 I3 投回
# req_dispatcher。只允许 agent:req_dispatcher:<safe-session>，session 匹配
# ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$；蓝区固定 main session，不接受裸 agent 或其他 agent。
# 不得留空：intake/legacy drain 会在序号、active/pending、batch intent 和网络调用前失败关闭。
DISPATCHER_CALLBACK_TARGET=agent:req_dispatcher:main

# 跨 agent 调用由 scripts/run_agent_turn.sh 的能力探测传输层统一处理：
#   新版使用 --session-key/--session-id + --message-file /dev/stdin；
#   2026.4.9 缺少安全 CLI 组合时只调用本机 loopback Gateway，正文绝不进入 argv。
# 未显式传 session 时，普通调用默认 agent:<target>:main；RUN_SINGLE_ISSUE 自动使用
# agent:<target>:issue-<sanitized-project>-<iid>；若旧上下文显式传 agent:<target>:main，
# RUN_SINGLE_ISSUE 仍会改投 issue 级 session，避免 executor main session 堵塞。
# TARGET_SESSION_KEY 是完整 key；真正的 TARGET_SESSION_ID 会在目标 agent registry
# 中唯一精确解析。历史上放进 TARGET_SESSION_ID 的完整 agent:* 值仅作 key alias。
# 该 CLI 使用 runner 已配置的 OpenClaw Gateway，不在本文件重复 pin 网关地址/token。
