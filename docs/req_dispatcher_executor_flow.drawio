        <mxCell id="e3" value="③ spawn git_issuer 建单" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=11;fontColor=#1a365d;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.45;" edge="1" parent="1" source="dCreateChain" target="gitIssuer">
