<mxfile host="app.diagrams.net" agent="Claude" version="24.7.5" type="device">
  <diagram id="req-pipeline-flow" name="req 三件套流程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="req_dispatcher / req_executor / git_issuer 端到端流程（driven 路径）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="4" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="zoneGreen" value="绿区&lt;br&gt;（开放办公网）" style="swimlane;startSize=44;container=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="180" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="nUser" value="企微用户&lt;br&gt;（需求发起人）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;arcSize=20;" vertex="1" parent="zoneGreen">
          <mxGeometry x="20" y="500" width="140" height="100" as="geometry" />
        </mxCell>

        <mxCell id="zone114" value="蓝区 · 10.64.5.114" style="swimlane;startSize=34;container=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="260" height="1160" as="geometry" />
        </mxCell>
        <mxCell id="nZhiban" value="&lt;b&gt;智伴 agent&lt;/b&gt;&lt;br&gt;接收企微需求并转发&lt;br&gt;接收结果并推送回企微" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="zone114">
          <mxGeometry x="30" y="500" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="zone104" value="蓝区 · 10.64.5.104 · OpenClaw 三件套" style="swimlane;startSize=34;container=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#eef3fb;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="40" width="1220" height="1240" as="geometry" />
        </mxCell>

        <mxCell id="dispBox" value="req_dispatcher（agent:req_dispatcher:main）— 编排器 / 薄控制器" style="swimlane;startSize=34;container=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#fff9e6;strokeColor=#d6b656;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="zone104">
          <mxGeometry x="20" y="40" width="960" height="430" as="geometry" />
        </mxCell>
        <mxCell id="dRouter" value="&lt;b&gt;首行路由（路径判定）&lt;/b&gt;&lt;br&gt;A 自然语言需求 · B 旧 I2 回调&lt;br&gt;C RUN_EXECUTOR_BATCH_TICK&lt;br&gt;D I3 回调 · E /slot · F /timeout-executor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe599;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dispBox">
          <mxGeometry x="20" y="44" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dOrigin" value="capture_origin.sh&lt;br&gt;捕获 origin（运行时元数据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dispBox">
          <mxGeometry x="280" y="44" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dPrep" value="prepare_downstream_payloads.sh&lt;br&gt;/ prepare_wiki_downstream_payloads.sh&lt;br&gt;（wiki 是唯一只读 GitLab 入口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dispBox">
          <mxGeometry x="490" y="44" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dRunAgent" value="run_agent_turn.sh&lt;br&gt;逐条 spawn git_issuer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dispBox">
          <mxGeometry x="760" y="44" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dSubmit" value="&lt;b&gt;submit_executor_batch.sh&lt;/b&gt;（唯一执行入口）&lt;br&gt;durable I1 intent + callback_nonce 先落盘&lt;br&gt;内部链 prepare→route→build→enqueue→drain&lt;br&gt;外层 timeout 由 get_executor_timeout_budget.sh 派生" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dispBox">
          <mxGeometry x="280" y="190" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dTick" value="run_executor_batch_tick.sh（Path C 周期恢复）&lt;br&gt;修 legacy bridge → 排空旧 FIFO&lt;br&gt;→ 同 ID 重投 durable I1 → 重试通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dispBox">
          <mxGeometry x="600" y="190" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dState" value="_dispatcher state&lt;br&gt;I1 outbox / receipt · batch mirror&lt;br&gt;I3 events ledger · 通知队列 · 旧 FIFO" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="dispBox">
          <mxGeometry x="20" y="320" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dHandler" value="&lt;b&gt;handle_executor_batch_event.sh&lt;/b&gt;（Path D）&lt;br&gt;核 nonce SHA-256 / project / executor&lt;br&gt;→ durable apply → stdout 唯一 ack JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dispBox">
          <mxGeometry x="280" y="320" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dNotify" value="notify_user.sh ← durable 通知队列&lt;br&gt;逐 Issue done / failed / timeout / skipped&lt;br&gt;（退避重试，失败不撤销 I3、不污染 ack）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dispBox">
          <mxGeometry x="600" y="320" width="340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="execBox" value="req_executor — GitLab 发现 · 共享调度 · worktree · acpx · push/MR/标签" style="swimlane;startSize=34;container=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#f3ebf7;strokeColor=#9673a6;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="zone104">
          <mxGeometry x="20" y="510" width="960" height="660" as="geometry" />
        </mxCell>
        <mxCell id="eIntake" value="&lt;b&gt;Path C/E：run_driven_issue_batch.sh&lt;/b&gt;&lt;br&gt;GraphQL 分页发现 → 连续两次全扫一致&lt;br&gt;→ 冻结 OPEN snapshot → 幂等 batch + 内嵌 tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="execBox">
          <mxGeometry x="20" y="44" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eAccept" value="emit_driven_batch_acceptance.sh&lt;br&gt;严格五字段 acceptance&lt;br&gt;status · batch_id · matched_count&lt;br&gt;· snapshot_digest · scheduler_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="execBox">
          <mxGeometry x="340" y="44" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eSched" value="共享严格 round-robin 调度器&lt;br&gt;claim fencing · 槽位上限（/slot）&lt;br&gt;acpx 上限（/timeout-executor）&lt;br&gt;→ scheduler_state.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="execBox">
          <mxGeometry x="20" y="190" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eSpawn" value="spawn_grants（每 tick ≤1）→ sessions_spawn 串行&lt;br&gt;同一 secret-free bootstrap&lt;br&gt;3 次尝试 × 2s backoff → record_spawn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="execBox">
          <mxGeometry x="340" y="190" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eAttempt" value="外层 subagent → run_executor_attempt.sh&lt;br&gt;固定 worktree issue/&amp;lt;iid&amp;gt; · acpx claude exec&lt;br&gt;stage → push → 建/复用 MR → worker_result.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="execBox">
          <mxGeometry x="660" y="190" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eTick" value="Path D：RUN_EXECUTOR_BATCH_TICK（executor 心跳）&lt;br&gt;recovery-first：handoff → outbox drain&lt;br&gt;→ coordinator 重放 → 再补位发放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="execBox">
          <mxGeometry x="20" y="340" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eOutbox" value="durable callback outbox → drain_driven_outbox.sh&lt;br&gt;逐 Issue I3：RUN_DRIVEN_BATCH_RESULT_ACK_ONLY&lt;br&gt;（batch_acceptance + callback_nonce + worker_result）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="execBox">
          <mxGeometry x="340" y="340" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ePhase6" value="Phase 6：dispatch_followup.sh&lt;br&gt;校验 compact JSON + live 校验&lt;br&gt;标签 doing → pr / finish / failed-* / timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="execBox">
          <mxGeometry x="660" y="340" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eNote" value="补充契约：同项目一对一依赖（Issue 正文声明“依赖 Issue #123”）→ 共享分支 issue/&amp;lt;A&amp;gt;+&amp;lt;C&amp;gt;（target→commit(A)→commit(C)），A 完成并校验后迁移 MR、C 以 A 的 SHA 为 lease 续跑，共享分支禁止 auto_merge；全部运行时状态在 ${REPO_PATH}/.req_executor/；inner acpx 剥离 GitLab token、禁 glab；保留 cron 旧路径 RUN_SCHEDULED_ISSUE_CAMPAIGN（Path A）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="execBox">
          <mxGeometry x="20" y="490" width="920" height="140" as="geometry" />
        </mxCell>

        <mxCell id="gitIssuer" value="&lt;b&gt;git_issuer&lt;/b&gt;&lt;br&gt;自由文本 → GitLab Issue&lt;br&gt;CREATE / CHANGE / CANCEL / SUPERSEDE&lt;br&gt;（只用 glab；建单时写 req_origin 标记 note）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="zone104">
          <mxGeometry x="1000" y="60" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gitlab" value="&lt;b&gt;GitLab（蓝区）&lt;/b&gt;&lt;br&gt;Issue + 工作流标签 + MR&lt;br&gt;工作流 ground truth&lt;br&gt;（磁盘 state 仅是进度缓存）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="zone104">
          <mxGeometry x="1000" y="600" width="200" height="160" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="① 企微发需求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nUser" target="nZhiban">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="② 转发需求原文（附 origin）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="nZhiban" target="dRouter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2b" value="控制命令 /slot N · /timeout-executor T" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b7791f;strokeWidth=1;dashed=1;dashPattern=1 4;fontSize=11;fontColor=#744210;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.85;" edge="1" parent="1" source="nZhiban" target="dRouter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Path A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;fontSize=11;fontColor=#333333;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="dRouter" target="dOrigin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dOrigin" target="dPrep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="create_issue / create_and_execute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dPrep" target="dRunAgent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="③ 建单（spawn）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dRunAgent" target="gitIssuer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="④ glab 建/改 Issue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gitIssuer" target="gitlab">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="⑤ 回调 → record_pending / drain_pending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.2;" edge="1" parent="1" source="gitIssuer" target="dState">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="execute_issue / create_and_execute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="dRouter" target="dSubmit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9b" value="先落盘 I1 intent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;fontSize=10;fontColor=#4a5568;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dSubmit" target="dState">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="⑥ I1 = RUN_DRIVEN_ISSUE_BATCH（同步等待）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dSubmit" target="eIntake">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="intake + 内嵌 tick" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;fontSize=10;fontColor=#4a5568;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="eIntake" target="eAccept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="⑦ 同步五字段 acceptance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="eAccept" target="dSubmit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eIntake" target="eSched">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="发放（每 tick ≤1 grant）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;fontSize=10;fontColor=#4a5568;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="eSched" target="eSpawn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="eSpawn" target="eAttempt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="native completion / durable result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;fontSize=10;fontColor=#4a5568;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eAttempt" target="ePhase6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="终态 handoff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;fontSize=10;fontColor=#4a5568;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ePhase6" target="eOutbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="⑧ 逐 Issue I3 回调" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="eOutbox" target="dHandler">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="⑨ ack accepted / duplicate（严格单行 JSON）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="dHandler" target="eOutbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="生成 durable 通知 intent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;fontSize=10;fontColor=#4a5568;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dHandler" target="dNotify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="⑩ 反向网关 104→114（唯一放行方向）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="dNotify" target="nZhiban">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="⑪ 推送结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="nZhiban" target="nUser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="同 batch ID 重投（ack 丢失 / receipt 未落）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#718096;strokeWidth=1;dashed=1;fontSize=11;fontColor=#4a5568;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="dTick" target="eIntake">
          <mxGeometry relative="1" as="geometry" />
