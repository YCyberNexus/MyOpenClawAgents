<mxfile host="app.diagrams.net" agent="Claude" version="24.7.5" type="device">
  <diagram id="req-pipeline-flow" name="req 三件套流程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="req_dispatcher / req_executor / git_issuer 端到端流程（driven 路径）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="4" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;图例（主流程编号）&lt;/b&gt;&lt;br&gt;① 企微用户发需求&lt;br&gt;② 智伴转发需求原文（附 origin）或控制命令（/slot · /repo-slot · /timeout-executor）&lt;br&gt;③ dispatcher 经 run_agent_turn.sh spawn git_issuer 建单&lt;br&gt;④ git_issuer 只用 glab 建/改 Issue（CREATE/CHANGE/CANCEL/SUPERSEDE，写 req_origin 标记 note）&lt;br&gt;⑤ git_issuer 回调 dispatcher → record_pending / drain_pending 审计&lt;br&gt;⑥ dispatcher 下发 I1 = RUN_DRIVEN_ISSUE_BATCH（durable intent + nonce 先落盘，同步等待）&lt;br&gt;⑦ executor 同步返回五字段 acceptance（status · batch_id · matched_count · snapshot_digest · scheduler_status）&lt;br&gt;⑧ executor 逐 Issue 回投 I3（RUN_DRIVEN_BATCH_RESULT_ACK_ONLY + batch_acceptance + nonce）&lt;br&gt;⑨ dispatcher 返回严格单行 ack（accepted / duplicate）&lt;br&gt;⑩ notify_user.sh 经 104→114 反向网关推送（唯一放行方向）&lt;br&gt;⑪ 智伴把结果推回企微用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;spacingRight=8;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="400" height="400" as="geometry" />
        </mxCell>

        <mxCell id="zoneGreen" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="160" height="320" as="geometry" />
        </mxCell>
        <mxCell id="zoneGreenLbl" value="绿区（开放办公网）" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#2f5b2f;" vertex="1" parent="1">
          <mxGeometry x="46" y="848" width="148" height="24" as="geometry" />
        </mxCell>
        <mxCell id="zone114" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="560" width="200" height="320" as="geometry" />
        </mxCell>
        <mxCell id="zone114Lbl" value="蓝区 · 10.64.5.114" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="246" y="848" width="188" height="24" as="geometry" />
        </mxCell>
        <mxCell id="zone104" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="1580" height="1410" as="geometry" />
        </mxCell>
        <mxCell id="zone104Lbl" value="蓝区 · 10.64.5.104 · OpenClaw 三件套" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="500" y="1420" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="dispRect" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="380" height="1130" as="geometry" />
        </mxCell>
        <mxCell id="dispLbl" value="req_dispatcher（agent:req_dispatcher:main）— 编排器 / 薄控制器" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#7b5e10;" vertex="1" parent="1">
          <mxGeometry x="508" y="76" width="364" height="20" as="geometry" />
        </mxCell>
        <mxCell id="execRect" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ebf7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="70" width="460" height="1290" as="geometry" />
        </mxCell>
        <mxCell id="execLbl" value="req_executor — GitLab 发现 · 共享调度 · worktree · acpx · push/MR/标签" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#553c9a;" vertex="1" parent="1">
          <mxGeometry x="1108" y="76" width="444" height="20" as="geometry" />
        </mxCell>

        <mxCell id="nUser" value="企微用户&lt;br&gt;（需求发起人）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nZhiban" value="&lt;b&gt;智伴 agent&lt;/b&gt;&lt;br&gt;接收企微需求并转发（附 origin）&lt;br&gt;接收结果并推送回企微" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="675" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="dRouter" value="&lt;b&gt;首行路由（路径判定）&lt;/b&gt;&lt;br&gt;A 自然语言需求 · B 旧 I2 回调&lt;br&gt;C RUN_EXECUTOR_BATCH_TICK&lt;br&gt;D I3 回调 · E /slot · F /repo-slot&lt;br&gt;G /timeout-executor · H /mission-stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe599;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dCreateChain" value="&lt;b&gt;建单链（Path A）&lt;/b&gt;&lt;br&gt;capture_origin.sh&lt;br&gt;→ prepare_downstream_payloads.sh / prepare_wiki_downstream_payloads.sh&lt;br&gt;→ run_agent_turn.sh（wiki 是唯一只读 GitLab 入口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="280" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dSubmit" value="&lt;b&gt;submit_executor_batch.sh&lt;/b&gt;（唯一执行入口）&lt;br&gt;durable I1 intent + callback_nonce 先落盘&lt;br&gt;内部链 prepare→route→build→enqueue→drain&lt;br&gt;外层 timeout 由 get_executor_timeout_budget.sh 派生" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="430" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dTick" value="&lt;b&gt;run_executor_batch_tick.sh&lt;/b&gt;（Path C 周期恢复）&lt;br&gt;修 legacy bridge → 排空旧 FIFO&lt;br&gt;→ 同 ID 重投 durable I1 → 重试通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="600" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dHandler" value="&lt;b&gt;handle_executor_batch_event.sh&lt;/b&gt;（Path D）&lt;br&gt;核 nonce SHA-256 / project / executor&lt;br&gt;→ durable apply → stdout 唯一 ack JSON&lt;br&gt;（receipt / mirror / I3 ledger 落盘）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="750" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dNotify" value="&lt;b&gt;notify_user.sh&lt;/b&gt; ← durable 通知队列&lt;br&gt;逐 Issue done / failed / timeout / skipped&lt;br&gt;（退避重试，失败不撤销 I3、不污染 ack）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="910" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dState" value="_dispatcher state&lt;br&gt;I1 outbox / receipt · batch mirror&lt;br&gt;I3 events ledger · 通知队列 · 旧 FIFO" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="1060" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="eTick" value="&lt;b&gt;Path D：RUN_EXECUTOR_BATCH_TICK&lt;/b&gt;（executor 心跳）&lt;br&gt;recovery-first：handoff → outbox drain&lt;br&gt;→ coordinator 重放 → 再补位发放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="120" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eIntake" value="&lt;b&gt;Path C/E：run_driven_issue_batch.sh&lt;/b&gt;（intake）&lt;br&gt;GraphQL 分页发现 → 连续两次全扫一致 → 冻结 OPEN snapshot&lt;br&gt;→ 幂等 batch + 内嵌 tick&lt;br&gt;→ emit_driven_batch_acceptance.sh 严格五字段 acceptance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="430" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eSched" value="&lt;b&gt;共享严格 round-robin 调度器&lt;/b&gt;&lt;br&gt;claim fencing · 并行仓库上限（/slot）&lt;br&gt;每仓库 Issue 上限（/repo-slot）&lt;br&gt;acpx 上限（/timeout-executor）→ scheduler_state.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="600" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eSpawn" value="&lt;b&gt;spawn_grants（每 tick ≤1）→ sessions_spawn 串行&lt;/b&gt;&lt;br&gt;同一 secret-free bootstrap&lt;br&gt;3 次尝试 × 2s backoff → record_spawn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="750" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eAttempt" value="&lt;b&gt;外层 subagent → run_executor_attempt.sh&lt;/b&gt;&lt;br&gt;固定 worktree issue/&amp;lt;iid&amp;gt; · acpx claude exec&lt;br&gt;stage → push → 建/复用 MR → worker_result.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="900" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ePhase6" value="&lt;b&gt;Phase 6：dispatch_followup.sh&lt;/b&gt;&lt;br&gt;校验 compact JSON + live 校验&lt;br&gt;标签 doing → pr / finish / failed-* / timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1070" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eOutbox" value="&lt;b&gt;durable callback outbox → drain_driven_outbox.sh&lt;/b&gt;&lt;br&gt;逐 Issue I3：RUN_DRIVEN_BATCH_RESULT_ACK_ONLY&lt;br&gt;（batch_acceptance + callback_nonce + worker_result）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1220" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="gitIssuer" value="&lt;b&gt;git_issuer&lt;/b&gt;&lt;br&gt;自由文本 → GitLab Issue&lt;br&gt;CREATE / CHANGE / CANCEL / SUPERSEDE&lt;br&gt;（只用 glab；建单时写 req_origin 标记 note）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="280" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gitlab" value="&lt;b&gt;GitLab（蓝区）&lt;/b&gt;&lt;br&gt;Issue + 工作流标签 + MR&lt;br&gt;工作流 ground truth&lt;br&gt;（磁盘 state 仅是进度缓存）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="900" width="360" height="220" as="geometry" />
        </mxCell>
        <mxCell id="eNote" value="&lt;b&gt;补充契约&lt;/b&gt;：同项目一对一依赖（Issue 正文声明“依赖 Issue #123”）→ 共享分支 issue/&amp;lt;A&amp;gt;+&amp;lt;C&amp;gt;（target→commit(A)→commit(C)），A 完成并校验后迁移 MR、C 以 A 的 SHA 为 lease 续跑，共享分支禁止 auto_merge；全部运行时状态在 ${REPO_PATH}/.req_executor/；inner acpx 剥离 GitLab token、禁 glab；保留 cron 旧路径 RUN_SCHEDULED_ISSUE_CAMPAIGN（Path A）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1640" y="1180" width="360" height="230" as="geometry" />
        </mxCell>

        <mxCell id="lbl4" value="④ glab 建/改 Issue" style="text;html=1;fontSize=11;fontColor=#1a365d;align=center;" vertex="1" parent="1">
          <mxGeometry x="1660" y="620" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lblGQL" value="GraphQL 发现 / snapshot / preflight" style="text;html=1;fontSize=10;fontColor=#553c9a;align=center;" vertex="1" parent="1">
          <mxGeometry x="1300" y="700" width="230" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lblLbl" value="标签转移 · live 校验" style="text;html=1;fontSize=10;fontColor=#553c9a;align=center;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1046" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lblETick" value="心跳 drain / 恢复" style="text;html=1;fontSize=11;fontColor=#4a5568;align=left;" vertex="1" parent="1">
          <mxGeometry x="1612" y="700" width="130" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lbl10" value="反向网关 104→114（唯一放行）" style="text;html=1;fontSize=10;fontColor=#1a365d;align=center;" vertex="1" parent="1">
          <mxGeometry x="235" y="905" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;html=1;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a365d;labelBackgroundColor=none;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="nUser" target="nZhiban">
