          </mxGeometry>
        </mxCell>
        <mxCell id="eCtrl" value="Path E/F → F/G 控制转发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;html=1;strokeColor=#b7791f;strokeWidth=1;dashed=1;dashPattern=1 4;fontSize=11;fontColor=#744210;labelBackgroundColor=none;exitX=1;exitY=0.8;entryX=0;entryY=0.33;" edge="1" parent="1" source="dRouter" target="eSched">
          <mxGeometry relative="1" as="geometry">
